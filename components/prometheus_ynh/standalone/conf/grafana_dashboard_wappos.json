{
  "title": "Wappos — vue d'ensemble",
  "uid": "wappos-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Source Prometheus"
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Vue d'ensemble", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100 },

    {
      "type": "stat", "title": "wappos_admin — requêtes/s",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 }, "id": 1,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(wappos_admin_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat", "title": "wappos_portal — requêtes/s",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 }, "id": 2,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(wappos_portal_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat", "title": "wappos_api — requêtes/s",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 }, "id": 3,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(wappos_api_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },

    {
      "type": "stat", "title": "wappos_admin — taux d'erreur (5xx)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 5 }, "id": 4,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "100 * sum(rate(wappos_admin_requests_total{status=~\"5..\"}[5m])) / sum(rate(wappos_admin_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "wappos_portal — taux d'erreur (5xx)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 5 }, "id": 5,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "100 * sum(rate(wappos_portal_requests_total{status=~\"5..\"}[5m])) / sum(rate(wappos_portal_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "wappos_api — taux d'erreur (5xx)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 5 }, "id": 6,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "100 * sum(rate(wappos_api_requests_total{status=~\"5..\"}[5m])) / sum(rate(wappos_api_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ] } }, "overrides": [] }
    },

    { "type": "row", "title": "Requêtes par seconde (par endpoint)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 101 },
    {
      "type": "timeseries", "title": "wappos_admin",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 }, "id": 10,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (endpoint) (rate(wappos_admin_requests_total[5m]))", "legendFormat": "{{endpoint}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "wappos_portal",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 }, "id": 11,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (endpoint) (rate(wappos_portal_requests_total[5m]))", "legendFormat": "{{endpoint}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "wappos_api",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 }, "id": 12,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (endpoint) (rate(wappos_api_requests_total[5m]))", "legendFormat": "{{endpoint}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },

    { "type": "row", "title": "Latence (p50 / p95)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "id": 102 },
    {
      "type": "timeseries", "title": "wappos_admin",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 }, "id": 20,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(wappos_admin_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(wappos_admin_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "wappos_portal",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 }, "id": 21,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(wappos_portal_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(wappos_portal_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "wappos_api",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 }, "id": 22,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(wappos_api_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(wappos_api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    { "type": "row", "title": "Prometheus lui-même", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "id": 103 },
    {
      "type": "timeseries", "title": "Cibles en échec (0 = tout va bien)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 }, "id": 30,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(up{job=~\"wappos_.*\"} == 0)", "legendFormat": "cibles down", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
