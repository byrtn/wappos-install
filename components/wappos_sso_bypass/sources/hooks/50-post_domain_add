#!/bin/bash
set -eu

domain="$1"

conf_dir="/etc/nginx/conf.d/${domain}.d"
mkdir -p "$conf_dir"

cat > "$conf_dir/wappos_sso_bypass.conf" <<'NGINX_EOF'
rewrite ^/$ /wappos-portal/ redirect;
rewrite ^/yunohost/sso$ /wappos-portal/ redirect;
rewrite ^/yunohost/sso/(?!applogos/|css/|assets/|customassets/|fonts/)(.*)$ /wappos-portal/$1 redirect;

location ~ ^/yunohost/sso/applogos/(.*)$ {
  access_by_lua_block {
    return
  }
  alias /usr/share/yunohost/applogos/$1;
}

location ~ ^/yunohost/sso/customassets/custom\.css$ {
  access_by_lua_block {
    return
  }
  alias /usr/share/yunohost/portal/customassets/$host.custom.css;
  etag off;
  expires off;
  more_set_headers "Cache-Control: no-store, no-cache, must-revalidate";
}

location ~ ^/yunohost/sso/(css|assets|fonts)/(.*)$ {
  access_by_lua_block {
    return
  }
  alias /usr/share/yunohost/portal/$1/$2;
}
NGINX_EOF

# Acces par IP brute (ou tout hote sans domaine correspondant) : YunoHost redirige
# nativement vers /yunohost/admin (fichier regenere par YunoHost, on l'ecrase ici,
# a reappliquer si un `yunohost tools regen-conf nginx --force` le restaure).
# On pointe vers le nom de domaine reel (pas $host, qui reprendrait l'IP tapee :
# /wappos-portal/ n'est proxifie que pour le vrai domaine, pas pour une IP brute).
mkdir -p /etc/nginx/conf.d/default.d
cat > /etc/nginx/conf.d/default.d/redirect_to_admin.conf <<NGINX_EOF
rewrite ^/\$ https://${domain}/wappos-portal/ redirect;
NGINX_EOF

nginx -t && systemctl reload nginx
