#!/bin/bash
set -eu

python3 /usr/local/lib/wappos_sso_bypass/regen_bypass_conf.py

# Acces par IP brute (ou tout hote sans domaine correspondant) : YunoHost redirige
# nativement vers /yunohost/admin (fichier regenere par YunoHost, on l'ecrase ici,
# a reappliquer si un `yunohost tools regen-conf nginx --force` le restaure).
# Redirection RELATIVE (pas de domaine en dur) : conserve l'IP/hote tape par le
# client. Necessite que /wappos-portal/ soit aussi configure dans default.d/
# (fait par wappos_portal_ynh) pour que la redirection aboutisse reellement.
mkdir -p /etc/nginx/conf.d/default.d
cat > /etc/nginx/conf.d/default.d/redirect_to_admin.conf <<'NGINX_EOF'
location / {
    if ($scheme = http) {
        return 308 https://$host$request_uri;
    }
    return 302 https://$host/wappos-portal/;
}
NGINX_EOF

cat > /etc/nginx/conf.d/default.d/wappos_sso_assets.conf <<'NGINX_EOF'
include /etc/nginx/conf.d/yunohost_sso.conf.inc;
NGINX_EOF

nginx -t && systemctl reload nginx
